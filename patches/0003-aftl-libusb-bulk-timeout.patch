Bound the libusb bulk transfers used for MTP reads and writes to 20 s.

Upstream passes timeout 0, which means wait forever: a Zune that stops answering (it does for a while after some
metadata edits) froze the caller for about 90 s until the device gave up. Each bulk call moves one max packet
(512 B), so 20 s is generous, and a timeout now surfaces as an exception the caller can report.
Apply in XuneSyncLibrary/vendor/android-file-transfer-linux/ after patch 0002.
---
diff --git a/mtp/backend/libusb/usb/Device.cpp b/mtp/backend/libusb/usb/Device.cpp
index 1049f27..68baa4c 100644
--- a/mtp/backend/libusb/usb/Device.cpp
+++ b/mtp/backend/libusb/usb/Device.cpp
@@ -24,6 +24,10 @@
 #include <mtp/ByteArray.h>
 #include <mtp/log.h>
 
+// Android patch: the upstream value 0 means "wait forever". A silent Zune then froze the app for ~90 s (until the device gave up).
+// Each bulk call moves one max-packet (512 B), so 20 s is generous; a timeout surfaces as an exception the caller can report.
+#define BULK_TIMEOUT_MS 20000
+
 namespace mtp { namespace usb
 {
 
@@ -73,7 +77,7 @@ namespace mtp { namespace usb
 			bytesRead = inputStream->Read(buffer.data(), buffer.size());
 			int tr = 0;
 			USB_CALL(libusb_bulk_transfer(_handle, ep->GetAddress(),
-				const_cast<u8*>(buffer.data()), bytesRead, &tr, 0));
+				const_cast<u8*>(buffer.data()), bytesRead, &tr, BULK_TIMEOUT_MS));
 		}
 		while(bytesRead == transferSize);
 	}
@@ -86,7 +90,7 @@ namespace mtp { namespace usb
 		do
 		{
 			tr = 0;
-			USB_CALL(libusb_bulk_transfer(_handle, ep->GetAddress(), buffer.data(), buffer.size(), &tr, 0));
+			USB_CALL(libusb_bulk_transfer(_handle, ep->GetAddress(), buffer.data(), buffer.size(), &tr, BULK_TIMEOUT_MS));
 			outputStream->Write(buffer.data(), tr);
 		}
 		while(tr == (int)transferSize);
