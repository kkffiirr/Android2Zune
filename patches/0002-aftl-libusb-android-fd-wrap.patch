 		libusb_free_device_list(devs, 0);
 	}
 
+	Context::Context(int androidFd, int debugLevel)
+	{
+		// Android apps cannot enumerate /dev/bus/usb or open a netlink hotplug socket;
+		// NO_DEVICE_DISCOVERY makes libusb_init() skip both. (It is an enum, not a macro, so no #ifdef.)
+		libusb_init_option noDiscovery = {};
+		noDiscovery.option = LIBUSB_OPTION_NO_DEVICE_DISCOVERY;
+		USB_CALL(libusb_init_context(&_ctx, &noDiscovery, 1));
+		libusb_set_debug(_ctx, debugLevel);
+		libusb_device_handle *handle;
+		USB_CALL(libusb_wrap_sys_device(_ctx, (intptr_t)androidFd, &handle));
+		_devices.push_back(std::make_shared<DeviceDescriptor>(libusb_get_device(handle), handle));
+	}
+
 	Context::~Context()
 	{
 		_devices.clear();
